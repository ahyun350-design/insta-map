ANTHROPIC_API_KEY=your_anthropic_api_key
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Public site origin for auth email / OAuth redirects (no trailing slash).
# Used by signup confirmation, password reset, Kakao OAuth — NOT window.location.origin.
# Fallback in code if unset: https://pindmap.com
NEXT_PUBLIC_SITE_URL=https://pindmap.com

# Playwright E2E (copy into .env.local — never commit real credentials)
# E2E_EMAIL=
# E2E_PASSWORD=
